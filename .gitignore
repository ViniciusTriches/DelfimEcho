# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — só o .env.example (sem valores reais) é versionado
.env*
!.env.example
*.pem
*.key
supabase/.env*
supabase/signing_keys.json

# configurações locais do Claude Code
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable: capturas e cache locais
.impeccable/review/
.impeccable/hook.cache.json
.impeccable/*.local.json

# PWA: gerado a cada build (scripts/gerar-sw.mjs)
public/sw.js
