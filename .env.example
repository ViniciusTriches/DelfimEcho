# Copie para .env.local e preencha.

# Supabase → Project Settings → API (ou `npx supabase status` no ambiente local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta (service role). Usada só pelo script de seed — nunca no navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# Único e-mail com permissão para entrar no Echo.
ALLOWED_EMAIL=voce@exemplo.com

# Opcional: URL pública do app (usada no link do e-mail). Se vazio, usa a origem da requisição.
# NEXT_PUBLIC_SITE_URL=https://echo.seudominio.com
